{
  "expo": {
    "name": "拾时",
    "slug": "shishi-journal",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/shishi-icon-v3.png",
    "scheme": "shishi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/shishi-icon-v3.png",
      "bundleIdentifier": "com.penguin95.shishi",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#EAF4F6",
        "foregroundImage": "./assets/images/shishi-mark-v3.png",
        "monochromeImage": "./assets/images/shishi-mark-v3.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.penguin95.shishi",
      "versionCode": 5
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-v3.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF4F6",
          "image": "./assets/images/shishi-mark-v3.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/noto-sans-sc/400Regular/NotoSansSC_400Regular.ttf",
            "./node_modules/@expo-google-fonts/noto-serif-sc/400Regular/NotoSerifSC_400Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "ShishiSans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/noto-sans-sc/400Regular/NotoSansSC_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "ShishiSerif",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/noto-serif-sc/400Regular/NotoSerifSC_400Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许拾时访问照片和视频，以便把媒体添加到记录中。",
          "cameraPermission": "允许拾时使用相机，以便拍摄并记录此刻。",
          "microphonePermission": "允许拾时在拍摄视频时录制声音。"
        }
      ],
      "expo-sqlite",
      "react-native-compressor",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许拾时在你主动选择时读取当前位置，用于记录这一刻发生的地点。"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允许拾时使用面容识别来保护你的私人记录。"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "backup-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "9d6be635-ea16-4571-abb8-dda97eb6f891"
      }
    },
    "owner": "95penguin"
  }
}
